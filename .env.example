# MammoFusion-XAI Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Server Host & Port
APP_HOST=127.0.0.1
APP_PORT=8000

# Application Environment (development, staging, production)
ENV=development

# Allowed CORS Origins (comma-separated list, no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Maximum Upload File Size in Megabytes (default: 25)
MAX_UPLOAD_SIZE_MB=25

# Minimum Image Dimensions (width and height in pixels)
MIN_IMAGE_DIMENSION=32

# Directory Paths (relative to project root or absolute)
MODELS_DIR=models
DATA_DIR=data
REPORTS_DIR=reports

